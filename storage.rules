rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function under5mb() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isAdminUser() {
      return signedIn() && (
        request.auth.token.email == 'yes.manujaya@gmail.com'
        || (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Public marketing / product / profile images — owner-scoped writes.
    // Private medical documents MUST use /medical/ (deny-all) later.

    match /uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
                   && (request.auth.uid == userId || isAdminUser())
                   && isImage()
                   && under5mb();
    }

    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
                   && (request.auth.uid == userId || isAdminUser())
                   && isImage()
                   && under5mb();
    }

    // Guide CMS — admin only (or Admin SDK from backend)
    match /guide/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminUser() && isImage() && under5mb();
    }

    // Reserved for future private medical documents — deny all client access.
    match /medical/{allPaths=**} {
      allow read, write: if false;
    }

    // Legacy flat upload paths — read OK for old URLs; no new client writes
    match /uploads/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
